## =================================================================
## RELATIONSHIPS (@ref properties) — SUPERSET
## =================================================================
## Each relationship is defined once with XSD cardinality.
## Profile restrictions are expressed separately below.
## -----------------------------------------------------------------

## --- ResourceFrame relationships ---

## netex:Operator.AuthorityRef — DEPRECATED (CEN PROPOSAL)
## Replaced by: Organisation referenced via ResponsibilitySet with StakeholderRoleType

netex:Vehicle netex:hasRef [
    netex:property "OrganisationRef" ;
    netex:target netex:Organisation ;
    netex:xsdCardinality "0..1" ;
    rdfs:comment "CEN PROPOSAL: was OperatorRef targeting Operator"
] , [
    netex:property "VehicleTypeRef" ;
    netex:target netex:VehicleType ;
    netex:xsdCardinality "0..1"
] .

netex:ResponsibilitySet netex:hasRef [
    netex:property "ResponsibleOrganisationRef" ;
    netex:target netex:Organisation ;
    netex:xsdCardinality "1..n" ;
    netex:path "roles/ResponsibilityRoleAssignment/ResponsibleOrganisationRef" ;
    rdfs:comment "CEN PROPOSAL: targets Organisation (not Authority/Operator). Cross-validate StakeholderRoleType assignment against Organisation.OrganisationType from registry."
] , [
    netex:property "StakeholderRoleType" ;
    netex:target xsd:string ;
    netex:xsdCardinality "1..1" ;
    netex:path "roles/ResponsibilityRoleAssignment/StakeholderRoleType" ;
    rdfs:comment "ASSIGNED ROLE: what the org does in this context. Verifiable against OrganisationType (rule-based). Enum: Planner | PublicTransportOperator | PublicTransportAuthority | Controller | StatutoryBody | CustomerService | LostAndFound | Reservation | EntityLegalOwnership | FareManagement | SecurityManagement | DataRegistrar. NO 'Other'."
] , [
    netex:property "ContractRef" ;
    netex:target netex:Contract ;
    netex:xsdCardinality "0..1" ;
    netex:path "roles/ResponsibilityRoleAssignment/AssociatedContract/ContractRef"
] .

netex:Contract netex:hasRef [
    netex:property "OrganisationRef (contractees)" ;
    netex:target netex:Organisation ;
    netex:xsdCardinality "0..n" ;
    netex:path "contractees/OrganisationRef" ;
    rdfs:comment "CEN PROPOSAL: was typed to Authority"
] , [
    netex:property "OrganisationRef (contractors)" ;
    netex:target netex:Organisation ;
    netex:xsdCardinality "0..n" ;
    netex:path "contractors/OrganisationRef" ;
    rdfs:comment "CEN PROPOSAL: was typed to Operator"
] .

## --- SiteFrame relationships ---

netex:StopPlace netex:hasRef [
    netex:property "TopographicPlaceRef" ;
    netex:target netex:TopographicPlace ;
    netex:xsdCardinality "0..1"
] , [
    netex:property "ParentSiteRef" ;
    netex:target netex:StopPlace ;
    netex:xsdCardinality "0..1" ;
    rdfs:comment "Multimodal parent stop — NP only"
] .
## TariffZoneRef — REMOVED in 3.0 (TariffZone transferred to FareZone)

netex:StopPlace netex:hasComposition [
    netex:property "quays" ;
    netex:target netex:Quay ;
    netex:xsdCardinality "0..n"
] .

netex:TopographicPlace netex:hasRef [
    netex:property "ParentTopographicPlaceRef" ;
    netex:target netex:TopographicPlace ;
    netex:xsdCardinality "0..1"
] .

netex:Parking netex:hasRef [
    netex:property "ParentSiteRef" ;
    netex:target netex:StopPlace ;
    netex:xsdCardinality "0..1"
] .

netex:FareZone netex:hasRef [
    netex:property "ScheduledStopPointRef" ;
    netex:target netex:ScheduledStopPoint ;
    netex:xsdCardinality "0..n" ;
    netex:path "members/ScheduledStopPointRef"
] .

## --- ServiceCalendarFrame relationships ---

netex:DayTypeAssignment netex:hasRef [
    netex:property "DayTypeRef" ;
    netex:target netex:DayType ;
    netex:xsdCardinality "0..1"
] , [
    netex:property "OperatingPeriodRef" ;
    netex:target netex:OperatingPeriod ;
    netex:xsdCardinality "0..1" ;
    rdfs:comment "Mutually exclusive with Date"
] .

## --- ServiceFrame relationships ---

netex:Line netex:hasRef [
    netex:property "responsibilitySetRef" ;
    netex:target netex:ResponsibilitySet ;
    netex:xsdCardinality "1..1" ;
    rdfs:comment "Replaces OperatorRef in 3.0 — operation role in ResponsibilitySet"
] , [
    netex:property "RepresentedByGroupRef" ;
    netex:target netex:GroupOfLines ;
    netex:xsdCardinality "0..1" ;
    rdfs:comment "Can also target Network — TBD for 3.0"
] .

netex:GroupOfLines netex:hasRef [
    netex:property "LineRef" ;
    netex:target netex:Line ;
    netex:xsdCardinality "1..n" ;
    netex:path "members/LineRef"
] .

## netex:Route relationships — REMOVED in 3.0

netex:JourneyPattern netex:hasRef [
    netex:property "LineRef" ;
    netex:target netex:Line ;
    netex:xsdCardinality "0..1" ;
    rdfs:comment "Optional direct link; primary path is SJ→LineRef"
] .

netex:JourneyPattern netex:hasComposition [
    netex:property "pointsInSequence" ;
    netex:target netex:StopPointInJourneyPattern ;
    netex:xsdCardinality "1..n"
] .

netex:StopPointInJourneyPattern netex:hasRef [
    netex:property "ScheduledStopPointRef" ;
    netex:target netex:ScheduledStopPoint ;
    netex:xsdCardinality "1..1"
] , [
    netex:property "DestinationDisplayRef" ;
    netex:target netex:DestinationDisplay ;
    netex:xsdCardinality "0..1"
] , [
    netex:property "NoticeRef" ;
    netex:target netex:Notice ;
    netex:xsdCardinality "0..1" ;
    netex:path "noticeAssignments/NoticeAssignment/NoticeRef"
] .

netex:PassengerStopAssignment netex:hasRef [
    netex:property "ScheduledStopPointRef" ;
    netex:target netex:ScheduledStopPoint ;
    netex:xsdCardinality "1..1"
] , [
    netex:property "StopPlaceRef" ;
    netex:target netex:StopPlace ;
    netex:xsdCardinality "0..1"
] , [
    netex:property "QuayRef" ;
    netex:target netex:Quay ;
    netex:xsdCardinality "1..1"
] .

## --- TimetableFrame relationships ---

netex:ServiceJourney netex:hasRef [
    netex:property "JourneyPatternRef" ;
    netex:target netex:JourneyPattern ;
    netex:xsdCardinality "1..1"
] , [
    netex:property "LineRef" ;
    netex:target netex:Line ;
    netex:xsdCardinality "1..1" ;
    rdfs:comment "MANDATORY in 3.0 — only path to Line (Route removed)"
] , [
    netex:property "responsibilitySetRef" ;
    netex:target netex:ResponsibilitySet ;
    netex:xsdCardinality "0..1" ;
    rdfs:comment "Overrides Line-level responsibility (e.g. replacement bus operator)"
] , [
    netex:property "VehicleTypeRef" ;
    netex:target netex:VehicleType ;
    netex:xsdCardinality "0..1" ;
    rdfs:comment "Passenger-facing hint (expect low-floor bus), NOT operational assignment. Use BlockRef for actual vehicle assignment."
] , [
    netex:property "DayTypeRef" ;
    netex:target netex:DayType ;
    netex:xsdCardinality "0..n" ;
    netex:path "dayTypes/DayTypeRef"
] , [
    netex:property "BlockRef" ;
    netex:target netex:TrainBlock ;
    netex:xsdCardinality "0..1"
] .

netex:ServiceJourney netex:hasComposition [
    netex:property "passingTimes" ;
    netex:target netex:TimetabledPassingTime ;
    netex:xsdCardinality "1..n"
] , [
    netex:property "parts" ;
    netex:target netex:JourneyPart ;
    netex:xsdCardinality "0..n" ;
    netex:path "parts/JourneyPart" ;
    rdfs:comment "NEW in 3.0: multi-operator journeys, per-segment facilities"
] .

## --- JourneyPart relationships (NEW in 3.0) ---

netex:JourneyPart netex:hasRef [
    netex:property "responsibilitySetRef" ;
    netex:target netex:ResponsibilitySet ;
    netex:xsdCardinality "0..1" ;
    rdfs:comment "Most specific override: operator for this segment"
] , [
    netex:property "TrainNumberRef" ;
    netex:target netex:TrainNumber ;
    netex:xsdCardinality "0..1"
] , [
    netex:property "FromStopPointRef" ;
    netex:target netex:ScheduledStopPoint ;
    netex:xsdCardinality "1..1"
] , [
    netex:property "ToStopPointRef" ;
    netex:target netex:ScheduledStopPoint ;
    netex:xsdCardinality "1..1"
] .

netex:DatedServiceJourney netex:hasRef [
    netex:property "ServiceJourneyRef" ;
    netex:target netex:ServiceJourney ;
    netex:xsdCardinality "1..1"
] , [
    netex:property "OperatingDayRef" ;
    netex:target netex:OperatingDay ;
    netex:xsdCardinality "1..1"
] , [
    netex:property "BlockRef" ;
    netex:target netex:TrainBlock ;
    netex:xsdCardinality "0..1"
] , [
    netex:property "DatedVehicleJourneyRef" ;
    netex:target netex:DatedServiceJourney ;
    netex:xsdCardinality "0..n" ;
    netex:path "replacedJourneys/DatedVehicleJourneyRef" ;
    rdfs:comment "Replaced/reinforced journeys"
] .

netex:Interchange netex:hasRef [
    netex:property "FromJourneyRef" ;
    netex:target netex:ServiceJourney ;
    netex:xsdCardinality "1..1"
] , [
    netex:property "ToJourneyRef" ;
    netex:target netex:ServiceJourney ;
    netex:xsdCardinality "1..1"
] , [
    netex:property "FromPointRef" ;
    netex:target netex:ScheduledStopPoint ;
    netex:xsdCardinality "0..1"
] , [
    netex:property "ToPointRef" ;
    netex:target netex:ScheduledStopPoint ;
    netex:xsdCardinality "0..1"
] .

## --- VehicleScheduleFrame relationships ---

netex:TrainBlock netex:hasRef [
    netex:property "OrganisationRef" ;
    netex:target netex:Organisation ;
    netex:xsdCardinality "0..1" ;
    rdfs:comment "CEN PROPOSAL: was OperatorRef targeting Operator"
] .

netex:TrainBlock netex:hasComposition [
    netex:property "journeys" ;
    netex:target netex:ServiceJourney ;
    netex:xsdCardinality "0..n" ;
    netex:path "journeys/VehicleJourneyRef" ;
    rdfs:comment "Bidirectional: Block lists its journeys, journeys reference Block via BlockRef"
] .

## =================================================================
## PROFILE CONSTRAINTS (NP)
## =================================================================
## NP-specific exclusions, allowances, and cardinality tightening vs XSD.
## -----------------------------------------------------------------

## --- Elements excluded from NP (ERP-only, forbidden in Nordic Profile) ---

profile:NP netex:excludes [
    netex:class netex:StopPlace ;
    netex:property "ParentSiteRef"
] , [
    netex:class netex:ServiceJourney ;
    netex:property "FlexibleLineRef"
] , [
    netex:class netex:ServiceJourney ;
    netex:property "BlockRef"
] .

## --- Elements allowed in NP (with cardinality) ---

profile:NP netex:allows [
    netex:class netex:StopPlace ;
    netex:property "TopographicPlaceRef" ;
    netex:cardinality "0..1"
] , [
    netex:class netex:StopPlace ;
    netex:property "ValidBetween" ;
    netex:cardinality "0..1"
] , [
    netex:class netex:StopPlace ;
    netex:property "AccessibilityAssessment" ;
    netex:cardinality "0..1"
] , [
    netex:class netex:Quay ;
    netex:property "AccessibilityAssessment" ;
    netex:cardinality "0..1"
] , [
    netex:class netex:Quay ;
    netex:property "boardingPositions" ;
    netex:cardinality "0..1"
] , [
    netex:class netex:Line ;
    netex:property "RepresentedByGroupRef" ;
    netex:cardinality "0..1"
] , [
    netex:class netex:Line ;
    netex:property "TransportSubmode" ;
    netex:cardinality "0..1"
] , [
    netex:class netex:Line ;
    netex:property "PublicCode" ;
    netex:cardinality "0..1"
] , [
    netex:class netex:Line ;
    netex:property "privateCodes" ;
    netex:cardinality "0..1"
] , [
    netex:class netex:DatedServiceJourney ;
    netex:property "DatedVehicleJourneyRef" ;
    netex:cardinality "0..n" ;
    rdfs:comment "Deviation/replacement tracking"
] , [
    netex:class netex:Interchange ;
    netex:property "FromPointRef" ;
    netex:cardinality "0..1"
] , [
    netex:class netex:Interchange ;
    netex:property "ToPointRef" ;
    netex:cardinality "0..1"
] .

## --- Cardinality tightening (XSD is looser than NP requires) ---

profile:NP netex:requires [
    netex:class netex:ServiceJourney ;
    netex:property "LineRef" ;
    netex:cardinality "1..1" ;
    rdfs:comment "MANDATORY in 3.0 — only path to Line (Route removed)"
] , [
    netex:class netex:Line ;
    netex:property "responsibilitySetRef" ;
    netex:cardinality "1..1" ;
    rdfs:comment "3.0 replaces OperatorRef — must declare operation responsibility"
] , [
    netex:class netex:Vehicle ;
    netex:property "VehicleTypeRef" ;
    netex:cardinality "1..1" ;
    rdfs:comment "XSD allows 0..1, NP mandates"
] , [
    netex:class netex:Organisation ;
    netex:property "Name" ;
    netex:cardinality "1..1" ;
    rdfs:comment "CEN PROPOSAL: was separate Authority.Name + Operator.Name requirements"
] , [
    netex:class netex:VehicleType ;
    netex:property "Name" ;
    netex:cardinality "1..1"
] , [
    netex:class netex:FareZone ;
    netex:property "Name" ;
    netex:cardinality "1..1"
] .

## =================================================================
## DOMAIN CHAINS (navigational shortcuts)
## =================================================================

netex:TimetableChain rdfs:comment """
    Line → JourneyPattern → ServiceJourney → DatedServiceJourney
    The core modelling chain: from abstract line identity
    through stop sequence, timed trip template,
    to a concrete instance on a specific date.
    ServiceJourney.LineRef links directly to Line (Route removed in 3.0).
""" ;
    netex:step1 netex:Line ;
    netex:step2 netex:JourneyPattern ;
    netex:step3 netex:ServiceJourney ;
    netex:step4 netex:DatedServiceJourney .

netex:StopChain rdfs:comment """
    ScheduledStopPoint → PassengerStopAssignment → StopPlace → Quay
    The logical-to-physical stop bridge.
""" ;
    netex:step1 netex:ScheduledStopPoint ;
    netex:step2 netex:PassengerStopAssignment ;
    netex:step3 netex:StopPlace ;
    netex:step4 netex:Quay .

netex:CalendarChain rdfs:comment """
    DayType → DayTypeAssignment → OperatingPeriod / Date
    How services are bound to dates.
""" ;
    netex:step1 netex:DayType ;
    netex:step2 netex:DayTypeAssignment ;
    netex:step3 netex:OperatingPeriod .

netex:OrganisationChain rdfs:comment """
    ResponsibilitySet → Organisation (with StakeholderRoleType) → Contract
    ResponsibilitySet is the single governance mechanism in 3.0.
    It assigns roles to Organisations via StakeholderRoleType enum:
      Planning (was Authority), Operation (was Operator), Control, DataOwner, Financing.
    Optionally linked to a Contract.
    CEN PROPOSAL: Authority/Operator classes deprecated in favour of roles.
""" ;
    netex:step1 netex:ResponsibilitySet ;
    netex:step2 netex:Organisation ;
    netex:step3 netex:Contract .

netex:ResponsibilityInheritanceChain rdfs:comment """
    Frame → Network → Line → ServiceJourney → JourneyPart
    ResponsibilitySet inheritance: most specific wins.
    Each level can carry a responsibilitySetRef that overrides the parent.
    Consumers resolve by walking inward: if JourneyPart has a RS, use it;
    else fall back to SJ, then Line, then Network, then Frame default.
""" ;
    netex:step1 netex:ResourceFrame ;
    netex:step2 netex:Network ;
    netex:step3 netex:Line ;
    netex:step4 netex:ServiceJourney ;
    netex:step5 netex:JourneyPart .

## =================================================================
## SIRI REAL-TIME BRIDGES
## =================================================================

@prefix siri: <https://siri-cen.eu/ontology#> .

siri:SIRI_ET a siri:Service ;
    rdfs:label "SIRI-ET — Estimated Timetable" ;
    siri:externalRepo "Profile_Documentation_SIRI" .

siri:SIRI_SX a siri:Service ;
    rdfs:label "SIRI-SX — Situation Exchange" ;
    siri:externalRepo "Profile_Documentation_SIRI" .

siri:SIRI_VM a siri:Service ;
    rdfs:label "SIRI-VM — Vehicle Monitoring" ;
    siri:externalRepo "Profile_Documentation_SIRI" .

siri:SIRI_FM a siri:Service ;
    rdfs:label "SIRI-FM — Facility Monitoring" ;
    siri:externalRepo "Profile_Documentation_SIRI" .

netex:Line netex:referencedBySIRI siri:SIRI_ET , siri:SIRI_SX , siri:SIRI_VM , siri:SIRI_FM ;
    rdfs:comment "Via LineRef in EstimatedVehicleJourney, MonitoredVehicleJourney, AffectedLine, FacilityLocation" .

## netex:Route SIRI references — REMOVED in 3.0
## SIRI-ET/SX will reference Line directly instead of Route

netex:ServiceJourney netex:referencedBySIRI siri:SIRI_ET , siri:SIRI_VM , siri:SIRI_SX ;
    rdfs:comment "Via FramedVehicleJourneyRef / DatedVehicleJourneyRef" .

netex:DatedServiceJourney netex:referencedBySIRI siri:SIRI_ET , siri:SIRI_VM , siri:SIRI_SX , siri:SIRI_FM ;
    rdfs:comment "Via DatedVehicleJourneyRef in all services" .

netex:JourneyPattern netex:referencedBySIRI siri:SIRI_ET ;
    rdfs:comment "Via JourneyPatternRef in EstimatedVehicleJourney" .

netex:Organisation netex:referencedBySIRI siri:SIRI_ET , siri:SIRI_VM , siri:SIRI_SX , siri:SIRI_FM ;
    rdfs:comment "CEN PROPOSAL: was Operator. Via OperatorRef in all services — becomes OrganisationRef" .

netex:Quay netex:referencedBySIRI siri:SIRI_ET , siri:SIRI_VM , siri:SIRI_SX ;
    rdfs:comment "Via StopPointRef in EstimatedCall, RecordedCall, MonitoredCall, AffectedStopPoint" .

netex:StopPlace netex:referencedBySIRI siri:SIRI_SX , siri:SIRI_FM , siri:SIRI_VM ;
    rdfs:comment "Via StopPlaceRef in AffectedStopPlace, FacilityLocation; OriginRef/DestinationRef in VM" .

netex:GroupOfLines netex:referencedBySIRI siri:SIRI_ET , siri:SIRI_SX ;
    rdfs:comment "Via GroupOfLinesRef (ET, mandatory for replacements), NetworkRef (SX AffectedNetwork)" .

## =================================================================
## TRANSMODEL ALIGNMENT
## =================================================================

netex:Organisation skos:exactMatch tm-org:Organisation ;
    rdfs:comment "CEN PROPOSAL: concrete Organisation. Transmodel already has Organisation as superclass." .

## netex:Authority/Operator Transmodel alignment — DEPRECATED (CEN PROPOSAL)
## Authority mapped to tm-org:Authority (role, not class in target state)
## Operator mapped to tm-org:Operator (role, not class in target state)

netex:StopPlace skos:exactMatch tm-fac:StopPlace .
netex:Quay skos:exactMatch tm-fac:Quay .
netex:TopographicPlace skos:closeMatch tm-journeys:TopographicPlace .
netex:Parking skos:closeMatch tm-fac:Garage .

netex:Line skos:exactMatch tm-journeys:Line .
## netex:Route — REMOVED in 3.0 (Transmodel alignment dropped)
netex:JourneyPattern skos:exactMatch tm-journeys:JourneyPattern .
netex:ScheduledStopPoint skos:exactMatch tm-journeys:ScheduledStopPoint .
netex:DestinationDisplay skos:exactMatch tm-journeys:DestinationDisplay .
netex:Network skos:closeMatch tm-commons:GroupOfEntities .

netex:ServiceJourney skos:exactMatch tm-journeys:ServiceJourney .
netex:DatedServiceJourney skos:exactMatch tm-journeys:DatedVehicleJourney .
netex:Interchange skos:closeMatch tm-journeys:Connection .
netex:StopPointInJourneyPattern skos:exactMatch tm-journeys:StopPointInJourneyPattern .

netex:DayType skos:exactMatch tm-journeys:DayType .
netex:DayTypeAssignment skos:exactMatch tm-journeys:DayTypeAssignment .
netex:OperatingPeriod skos:exactMatch tm-journeys:OperatingPeriod .
netex:OperatingDay skos:exactMatch tm-journeys:OperatingDay .

netex:Vehicle skos:closeMatch tm-journeys:Vehicle .

netex:ShelterEquipment skos:exactMatch tm-fac:ShelterEquipment .
netex:WaitingRoomEquipment skos:exactMatch tm-fac:WaitingRoomEquipment .
netex:SanitaryEquipment skos:exactMatch tm-fac:SanitaryEquipment .
netex:TicketingEquipment skos:exactMatch tm-fac:TicketingEquipment .

## netex:TariffZone — REMOVED in 3.0
netex:FareZone skos:closeMatch tm-commons:Zone .

netex:AccessibilityAssessment skos:exactMatch tm-fac:AccessibilityAssessment .

