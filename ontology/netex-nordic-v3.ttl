##
## Pattern (CEN PROPOSAL — replaces single PrivateCode element):
##   <privateCodes>
##     <PrivateCode type="RICS">1242</PrivateCode>
##   </privateCodes>
## -----------------------------------------------------------------

netex:StopPlace netex:elementOrder [
